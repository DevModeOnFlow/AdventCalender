@model IEnumerable<AdventCalender.Models.ApplicationUser>

@{
    ViewData["Title"] = "Маркетплейс";
}

<div class="container py-4">
    <div class="text-center mb-4">
        <h2 class="fw-bold text-danger mb-1">AdventCalenders</h2>
        <p class="text-muted small">Найдите свой идеальный адвент-календарь</p>
    </div>

    <div class="row justify-content-center mb-4">
        <div class="col-md-5 col-lg-4"> 
            <form asp-action="Index" method="get" class="shadow-sm rounded-pill p-1 bg-white border d-flex align-items-center" style="height: 42px;">
                <input type="text" name="searchString" 
                       value="@ViewData["CurrentFilter"]" 
                       class="form-control border-0 bg-transparent rounded-pill px-3 py-1 small" 
                       placeholder="Поиск магазина..." 
                       style="box-shadow: none; font-size: 0.85rem;">
                
                @if (!string.IsNullOrEmpty(ViewData["CurrentFilter"]?.ToString()))
                {
                    <a asp-action="Index" class="text-muted me-2" title="Сбросить">
                        <i class="bi bi-x-circle"></i>
                    </a>
                }

                <button type="submit" class="btn btn-danger rounded-pill px-3 py-1 btn-sm fw-bold shadow-sm h-100">
                    Найти
                </button>
            </form>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <h4 class="text-muted">Ничего не найдено</h4>
            <a asp-action="Index" class="btn btn-sm btn-outline-danger mt-2 rounded-pill px-3">Сбросить поиск</a>
        </div>
    }
    else
    {
        <div class="row g-3" id="sellers-container">
            <partial name="SellerCardList" model="Model" />
        </div>

        <div id="loading-spinner" class="text-center py-4 d-none">
            <div class="spinner-border text-danger" role="status">
                <span class="visually-hidden">Загрузка...</span>
            </div>
        </div>
    }
</div>

<style>
    body { background-color: #f8f9fa; }

    .hover-lift {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .hover-lift:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 20px rgba(0, 0, 0, 0.05) !important;
    }

    .hover-grow {
        transition: transform 0.2s;
    }
    .hover-grow:hover {
        transform: scale(1.03);
    }

    .rounded-4 { border-radius: 1rem; }
    
    .small { font-size: 0.85rem; }
</style>

@section Scripts {
    <script>
        let currentPage = 1;
        let totalPages = @(ViewBag.TotalPages ?? 1);
        let isLoading = false;
        let searchString = '@Html.Raw(ViewData["CurrentFilter"])';

        window.addEventListener('scroll', () => {
            if (isLoading || currentPage >= totalPages) return;

            if ((window.innerHeight + window.scrollY) >= document.body.offsetHeight - 200) {
                loadMoreSellers();
            }
        });

        function loadMoreSellers() {
            isLoading = true;
            document.getElementById('loading-spinner').classList.remove('d-none'); 
            
            currentPage++; 

            fetch(`/Home/LoadMore?searchString=${encodeURIComponent(searchString)}&page=${currentPage}`)
                .then(response => response.text())
                .then(html => {
                    document.getElementById('sellers-container').insertAdjacentHTML('beforeend', html);
                    
                    isLoading = false;
                    document.getElementById('loading-spinner').classList.add('d-none'); 
                })
                .catch(error => {
                    console.error('Ошибка при загрузке:', error);
                    isLoading = false;
                    document.getElementById('loading-spinner').classList.add('d-none');
                });
        }
    </script>
   }