@model IEnumerable<AdventCalender.Models.ApplicationUser>

<div class="container py-5">
    <div class="text-center mb-5">
        <h1 class="display-3 fw-bold">🎁 Advent Marketplace</h1>
        <p class="lead">Выберите календарь и забирайте подарки каждый день!</p>
    </div>

    <div class="row g-4">
        @foreach (var seller in Model)
        {
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm rounded-4 hover-lift">
                    <div class="card-body p-4 text-center">
                        <div class="bg-danger bg-opacity-10 rounded-circle d-inline-block p-3 mb-3">
                            <span class="h2 mb-0">🏪</span>
                        </div>
                        <h4 class="fw-bold">@seller.StoreName</h4>
                        <p class="text-muted small">@seller.Description</p>
                        
                        <div class="badge bg-light text-dark mb-3">
                            📅 Календарь на @(seller.CalendarDaysCount > 0 ? seller.CalendarDaysCount : 24) дня
                        </div>
                    </div>
                    <div class="card-footer bg-transparent border-0 p-4 pt-0">
                        <a asp-controller="Calendar" asp-action="Index" asp-route-sellerId="@seller.Id" 
                           class="btn btn-danger w-100 rounded-pill py-2 fw-bold shadow-sm">
                           Смотреть календарь
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>