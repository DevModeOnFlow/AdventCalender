@model AdventCalender.Models.AdventDay

@{
    ViewData["Title"] = (Model.Id == 0 ? "Добавить" : "Редактировать") + " день " + Model.DayNumber;
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card border-0 shadow-lg">
                <div class="card-body p-4 p-md-5">
                    <h2 class="fw-bold mb-4">📅 Настройка дня @Model.DayNumber</h2>
                    
                    <form asp-action="SaveDay" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>
                        
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="DayNumber" />
                        <input type="hidden" asp-for="SellerId" />

                        <div class="mb-3">
                            <label asp-for="Title" class="form-label fw-bold small text-uppercase">Название товара/сюрприза</label>
                            <input asp-for="Title" class="form-control form-control-lg shadow-sm" placeholder="Напр: Ароматная свеча" required />
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label fw-bold small text-uppercase">Описание</label>
                            <textarea asp-for="Description" class="form-control shadow-sm" rows="3" placeholder="Расскажите подробнее о подарке..."></textarea>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label asp-for="Price" class="form-label fw-bold small text-uppercase">Цена (₽)</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-white">₽</span>
                                    <input asp-for="Price" type="number" step="0.01" class="form-control shadow-sm" required />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="ImageUrl" class="form-label fw-bold small text-uppercase">Ссылка на фото</label>
                                <input asp-for="ImageUrl" class="form-control shadow-sm" placeholder="http://..." />
                            </div>
                        </div>

                        <div class="d-flex gap-2 mt-4">
                            <a asp-action="Dashboard" class="btn btn-light border flex-grow-1">Отмена</a>
                            <button type="submit" class="btn btn-primary flex-grow-1 shadow">Сохранить</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>