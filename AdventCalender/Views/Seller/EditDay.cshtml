@model AdventCalender.Models.AdventDay

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow border-0 rounded-4">
                <div class="card-body p-4">
                    <h3 class="fw-bold mb-4 text-center">Настройка дня @Model.DayNumber</h3>
                    
                    <form asp-action="SaveDay" method="post">
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="DayNumber" />
                        <input type="hidden" asp-for="SellerId" />

                        <div asp-validation-summary="All" class="text-danger small mb-3"></div>

                        <div class="mb-3">
                            <label class="form-label small fw-bold">Название подарка</label>
                            <input asp-for="Title" class="form-control" />
                            <span asp-validation-for="Title" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label small fw-bold">Описание</label>
                            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="StartTime" class="form-label small fw-bold text-uppercase">Время открытия</label>
                                <input asp-for="StartTime" type="time" class="form-control shadow-sm" required />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="EndTime" class="form-label small fw-bold text-uppercase">Время закрытия</label>
                                <input asp-for="EndTime" type="time" class="form-control shadow-sm" required />
                            </div>

                            <div class="col-md-6 mb-3">
                                <label class="form-label small fw-bold">Цена ($)</label>
                                <input asp-for="Price" type="number" step="0.01" class="form-control" />
                            </div>

                            <div class="col-md-6 mb-3">
                                <label class="form-label small fw-bold">URL картинки</label>
                                <input asp-for="ImageUrl" class="form-control" placeholder="http://..." />
                            </div>
                        </div>

                        <div class="d-flex gap-2 mt-4">
                            <a asp-action="Dashboard" class="btn btn-light border flex-grow-1 rounded-pill">Отмена</a>
                            <button type="submit" class="btn btn-primary flex-grow-1 rounded-pill shadow">Сохранить</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>