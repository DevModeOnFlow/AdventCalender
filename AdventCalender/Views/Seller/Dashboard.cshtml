@model AdventCalender.Models.ApplicationUser

@{
    ViewData["Title"] = "Панель управления магазином";
    int filledDays = Model.AdventDays.Count;
    int progressPercent = (int)((filledDays / 24.0) * 100);
}

<div class="container py-4">
    <!-- Блок уведомлений -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm mb-4 rounded-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- 1. ВЕРХНЯЯ ПАНЕЛЬ: ПРОФИЛЬ И СТАТИСТИКА -->
    <div class="card border-0 shadow-sm rounded-4 mb-4 overflow-hidden">
        <div class="card-body p-4 p-md-5 bg-white">
            <div class="row align-items-center">
                <div class="col-lg-7 mb-4 mb-lg-0">
                    <div class="d-flex align-items-center mb-3">
                        <div class="bg-primary bg-opacity-10 p-3 rounded-4 me-3">
                            <span class="h2 mb-0">🏪</span>
                        </div>
                        <div>
                            <h2 class="fw-bold mb-0">@Model.StoreName</h2>
                            <span class="badge bg-light text-primary border border-primary border-opacity-25 rounded-pill">Активный магазин</span>
                        </div>
                    </div>
                    <p class="text-muted mb-4 pe-lg-5">@Model.Description</p>
                    <button class="btn btn-outline-primary rounded-pill px-4 btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#editProfileForm">
                        ⚙️ Настройки профиля
                    </button>
                </div>
                <div class="col-lg-5">
                    <div class="bg-light p-4 rounded-4">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="fw-bold">Заполнение календаря</span>
                            <span class="text-primary fw-bold">@filledDays / 24</span>
                        </div>
                        <div class="progress rounded-pill mb-0" style="height: 12px;">
                            <div class="progress-bar progress-bar-striped progress-bar-animated bg-primary" 
                                 role="progressbar" style="width: @progressPercent%"></div>
                        </div>
                        <small class="text-muted d-block mt-2">Заполните все ячейки, чтобы привлечь больше покупателей!</small>
                    </div>
                </div>
            </div>

            <!-- Скрытая форма редактирования -->
            <div class="collapse mt-4" id="editProfileForm">
                <hr class="my-4 text-muted opacity-25">
                <form asp-action="UpdateStore" method="post" class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label small fw-bold text-uppercase">Название магазина</label>
                        <input type="text" name="storeName" class="form-control rounded-3" value="@Model.StoreName" required>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-bold text-uppercase">Описание</label>
                        <input type="text" name="description" class="form-control rounded-3" value="@Model.Description">
                    </div>
                    <div class="col-md-2 d-flex align-items-end">
                        <button type="submit" class="btn btn-dark w-100 rounded-3">Сохранить</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- 2. СЕТКА КАЛЕНДАРЯ (НА ВСЮ ШИРИНУ) -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="fw-bold mb-0">Управление ячейками</h4>
        <span class="text-muted small">Выберите день для редактирования</span>
    </div>

    <div class="row row-cols-2 row-cols-sm-3 row-cols-md-4 row-cols-lg-6 g-3">
        @for (int i = 1; i <= 24; i++)
        {
            var dayData = Model.AdventDays.FirstOrDefault(d => d.DayNumber == i);
            
            <div class="col">
                <div class="card h-100 border-0 shadow-sm day-card @(dayData != null ? "active-day" : "empty-day")">
                    <div class="card-body p-3 text-center d-flex flex-column h-100">
                        <div class="day-number mb-2">@i</div>
                        
                        @if (dayData != null)
                        {
                            <div class="small fw-bold text-truncate mb-1">@dayData.Title</div>
                            <div class="text-primary small mb-3">@dayData.Price.ToString("N0") ₽</div>
                            
                            <div class="mt-auto d-flex justify-content-center gap-1">
                                <a asp-action="EditDay" asp-route-id="@dayData.Id" 
                                   class="btn btn-sm btn-white border shadow-sm rounded-circle p-0 d-flex align-items-center justify-content-center" 
                                   style="width: 32px; height: 32px;" title="Редактировать">✏️</a>
                                
                                <form asp-action="DeleteDay" asp-route-id="@dayData.Id" method="post" 
                                      onsubmit="return confirm('Удалить этот день?')">
                                    <button type="submit" class="btn btn-sm btn-white border shadow-sm rounded-circle p-0 d-flex align-items-center justify-content-center text-danger" 
                                            style="width: 32px; height: 32px;" title="Удалить">🗑️</button>
                                </form>
                            </div>
                        }
                        else
                        {
                            <div class="mt-auto">
                                <a asp-action="EditDay" asp-route-dayNumber="@i" 
                                   class="btn btn-sm btn-outline-secondary border-dashed rounded-3 w-100 py-2">
                                    <span class="small">+ Добавить</span>
                                </a>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<style>
    body { background-color: #f0f2f5; }
    
    .rounded-4 { border-radius: 1.25rem; }
    
    /* Стили ячеек */
    .day-card {
        border-radius: 1rem;
        transition: all 0.2s ease-in-out;
    }
    
    .day-card.empty-day {
        background-color: rgba(255,255,255,0.5);
    }
    
    .day-card.active-day {
        background: white;
        border-bottom: 4px solid #0d6efd !important;
    }
    
    .day-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 0.5rem 1rem rgba(0,0,0,0.1) !important;
    }
    
    .day-number {
        font-size: 1.5rem;
        font-weight: 800;
        color: #dee2e6;
        line-height: 1;
    }
    
    .active-day .day-number {
        color: #0d6efd;
    }
    
    .border-dashed {
        border: 1px dashed #adb5bd !important;
    }

    .btn-white {
        background-color: white;
    }
    
    /* Для плавного появления формы */
    .collapse {
        transition: all 0.4s ease;
    }
</style>