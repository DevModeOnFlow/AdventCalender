@using System.Globalization
@model AdventCalender.Models.ApplicationUser

@{
    ViewData["Title"] = "Панель управления магазином";

    DateTime startDate = Model.CalendarStartDate.Date;
    DateTime endDate = Model.CalendarEndDate.Date;
    
    int totalDays = (endDate - startDate).Days + 1;
    if (totalDays < 1) totalDays = 1;

    var filledDaysCount = Model.AdventDays.Count(d => d.DayNumber <= totalDays);
    int progressPercent = (int)((filledDaysCount / (double)totalDays) * 100);

    bool isComplete = progressPercent == 100;
    string statusColor = isComplete ? "success" : "danger"; 
    string statusIcon = isComplete ? "🚀" : "🏪";
}

<div class="container py-4">
    
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm mb-4 rounded-4" role="alert">
            <div class="d-flex align-items-center">
                <span class="fs-4 me-3">✅</span>
                <div>@TempData["Success"]</div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm mb-4 rounded-4" role="alert">
            <div class="d-flex align-items-center">
                <span class="fs-4 me-3">⚠️</span>
                <div>@TempData["Error"]</div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card border-0 shadow-sm rounded-4 mb-5 overflow-hidden">
        <div class="card-body p-4 p-md-5 bg-white">
            <div class="row align-items-center">
               <div class="col-lg-7 mb-4 mb-lg-0">
                    <div class="d-flex align-items-center mb-3">
                        <div class="bg-@statusColor bg-opacity-10 p-3 rounded-4 me-3">
                            <span class="h2 mb-0">@statusIcon</span>
                        </div>
                        <div>
                            <h2 class="fw-bold mb-0">@Model.StoreName</h2>
                            <p class="text-muted mb-0 small text-uppercase fw-bold">Аккаунт: @(Model.Nickname ?? Model.UserName)</p>
                        </div>
                    </div>
                    <p class="text-muted mb-4 pe-lg-5 fs-5">
                        @(string.IsNullOrEmpty(Model.Description) ? "Ваш магазин пока без описания." : Model.Description)
                    </p>
                    <div class="d-flex gap-2">
                        <button class="btn btn-dark rounded-pill px-4 shadow-sm" type="button" data-bs-toggle="collapse" data-bs-target="#editSettings">
                            ⚙️ Настройки
                        </button>
        
                        <a asp-controller="Calendar" asp-action="Index" asp-route-sellerId="@Model.Id" target="_blank" 
                           class="btn btn- rounded-pill px-4 shadow-sm fw">@("Просмотр витрины")
                        </a>
                    </div>
                </div>

                <div class="col-lg-5">
                    <div class="bg-light p-4 rounded-4 border border-white border-2 shadow-sm">
                        <div class="d-flex justify-content-between align-items-end mb-2">
                            <div>
                                <h6 class="text-uppercase fw-bold text-muted small mb-1">Статус заполнения</h6>
                                <span class="h3 fw-bold mb-0 text-@statusColor">@filledDaysCount <span class="text-muted h5 fw-normal">/ @totalDays</span></span>
                            </div>
                            <span class="badge bg-@statusColor rounded-pill px-3 py-2 shadow-sm">@progressPercent%</span>
                        </div>
        
                        <div class="progress rounded-pill bg-white mb-2" style="height: 14px;">
                            <div class="progress-bar progress-bar-striped @(isComplete ? "" : "progress-bar-animated") bg-@statusColor" 
                                 role="progressbar" style="width: @progressPercent%"></div>
                        </div>
        
                        @if(isComplete) {
                            <small class="text-success fw-bold mt-2 d-block">✨ Идеально! Ваш календарь полностью укомплектован.</small>
                        } else {
                            <small class="text-muted fw-light mt-2 d-block">Заполните еще @(totalDays - filledDaysCount) ячеек до полной готовности.</small>
                        }
                    </div>
                </div>
            </div>

            <div class="collapse mt-4" id="editSettings">
                <div class="p-4 bg-light rounded-4 border">
                    <h5 class="fw-bold mb-4 border-bottom pb-2">Редактирование параметров магазина</h5>
                    <form asp-action="UpdateStore" method="post" class="row g-4">
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-uppercase">Название магазина</label>
                            <input type="text" name="storeName" class="form-control rounded-3 py-2 shadow-sm" value="@Model.StoreName" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-uppercase">Краткое описание</label>
                            <input type="text" name="description" class="form-control rounded-3 py-2 shadow-sm" value="@Model.Description">
                        </div>
                        
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-uppercase text-danger">📅 Дата запуска</label>
                            <input type="date" name="calendarStartDate" class="form-control rounded-3 py-2 shadow-sm" 
                                   value="@Model.CalendarStartDate.ToString("yyyy-MM-dd")" required>
                            <div class="form-text small">День, когда откроется первая ячейка.</div>
                        </div>
                        
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-uppercase text-danger">🏁 Дата окончания</label>
                            <input type="date" name="calendarEndDate" class="form-control rounded-3 py-2 shadow-sm" 
                                   value="@Model.CalendarEndDate.ToString("yyyy-MM-dd")" required>
                            <div class="form-text small">Последний день вашей акции.</div>
                        </div>

                        <div class="col-12 text-end mt-4">
                            <button type="button" class="btn btn-link text-muted me-2 text-decoration-none" data-bs-toggle="collapse" data-bs-target="#editSettings">Отмена</button>
                            <button type="submit" class="btn btn-primary px-5 rounded-pill shadow-lg fw-bold">Сохранить изменения</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="fw-bold mb-0">🛠 Управление ячейками</h4>
        <div class="text-muted small">Период на <strong>@totalDays дней</strong></div>
    </div>

    <div class="row row-cols-2 row-cols-sm-3 row-cols-md-4 row-cols-lg-6 g-3">
        @for (int i = 1; i <= totalDays; i++)
        {
            var dayData = Model.AdventDays.FirstOrDefault(d => d.DayNumber == i);
            DateTime currentCellDate = startDate.AddDays(i - 1);
            
            <div class="col">
                <div class="card h-100 border-0 shadow-sm day-card @(dayData != null ? "active-day shadow-md" : "empty-day")">
                    <div class="card-body p-3 text-center d-flex flex-column h-100">
                        
                        <div class="day-number mb-1">@i</div>
                        <div class="small text-muted fw-bold mb-3" style="font-size: 0.7rem;">@currentCellDate.ToString("dd MMM")</div>
                        
                        @if (dayData != null)
                        {
                            <div class="small fw-bold text-truncate mb-1 px-1">@dayData.Title</div>
                            <div class="text-danger fw-bold small mb-3">@dayData.Price.ToString("C", CultureInfo.GetCultureInfo("en-US"))</div>
                            
                            <div class="small text-muted mb-3" style="font-size: 0.65rem;">
                                🕒 @dayData.StartTime.ToString(@"hh\:mm") - @dayData.EndTime.ToString(@"hh\:mm")
                            </div>

                            <div class="mt-auto d-flex justify-content-center gap-2">
                                <a asp-action="EditDay" asp-route-id="@dayData.Id" 
                                   class="btn btn-sm btn-white border shadow-sm rounded-circle p-0 d-flex align-items-center justify-content-center" 
                                   style="width: 34px; height: 34px;" title="Изменить">✏️</a>
                                
                                <form asp-action="DeleteDay" asp-route-id="@dayData.Id" method="post" 
                                      onsubmit="return confirm('Удалить товар из ячейки @i (@currentCellDate.ToShortDateString())?')">
                                    <button type="submit" class="btn btn-sm btn-white border shadow-sm rounded-circle p-0 d-flex align-items-center justify-content-center text-danger" 
                                            style="width: 34px; height: 34px;" title="Удалить">🗑️</button>
                                </form>
                            </div>
                        }
                        else
                        {
                            <div class="mt-auto">
                                <a asp-action="EditDay" asp-route-dayNumber="@i" 
                                   class="btn btn-sm btn-outline-secondary border-dashed rounded-3 w-100 py-3 shadow-none">
                                    <div class="small fw-bold">+ Настроить</div>
                                </a>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<style>
    body { background-color: #f3f6f9; }
    
    .rounded-4 { border-radius: 1.25rem !important; }
    
    .day-card {
        border-radius: 1.25rem;
        transition: all 0.25s ease;
        border: 2px solid transparent !important;
    }
    
    .day-card.empty-day {
        background-color: rgba(255,255,255,0.4);
    }
    
    .day-card.active-day {
        background: white;
        border-bottom-color: #dc3545 !important;
    }
    
    .day-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 0.8rem 1.5rem rgba(0,0,0,0.08) !important;
    }
    
    .day-number {
        font-size: 1.8rem;
        font-weight: 900;
        color: #dee2e6;
        line-height: 1;
        letter-spacing: -1px;
    }
    
    .active-day .day-number {
        color: #dc3545;
    }
    
    .border-dashed {
        border: 2px dashed #ced4da !important;
    }
    .border-dashed:hover {
        border-color: #dc3545 !important;
        background-color: #fff !important;
        color: #dc3545 !important;
    }

    .btn-white {
        background-color: white;
        transition: all 0.2s;
    }
    .btn-white:hover {
        background-color: #f8f9fa;
        transform: scale(1.1);
    }

    .progress-bar-animated {
        animation: progress-bar-stripes 1s linear infinite;
    }
</style>