@model AdventCalender.Models.ApplicationUser

@{
    ViewData["Title"] = "Управление магазином";
}

<div class="container py-4">
    <h2 class="mb-4 fw-bold">⚙️ Личный кабинет продавца</h2>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row">
        <div class="col-lg-4 mb-4">
            <div class="card border-0 shadow-sm p-3">
                <h4 class="card-title mb-3">Профиль магазина</h4>
                <form asp-action="UpdateStore" method="post">
                    <div class="mb-3">
                        <label class="form-label text-muted small">Название магазина</label>
                        <input type="text" name="storeName" class="form-control" value="@Model.StoreName" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-muted small">Описание (будет видно покупателям)</label>
                        <textarea name="description" class="form-control" rows="4">@Model.Description</textarea>
                    }
                    <button type="submit" class="btn btn-primary w-100 mt-2">Обновить профиль</button>
                </form>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="card border-0 shadow-sm p-3">
                <h4 class="card-title mb-3">Ваш Адвент-календарь (24 дня)</h4>
                <p class="text-muted small">Заполните каждый день товаром или услугой.</p>
                
                <div class="row g-2">
                    @for (int i = 1; i <= 24; i++)
                    {
                        var dayData = Model.AdventDays.FirstOrDefault(d => d.DayNumber == i);
                        <div class="col-6 col-md-4 col-xl-3">
                            <div class="card h-100 @(dayData != null ? "border-success bg-light" : "border-dashed text-muted")">
                                <div class="card-body p-2 text-center d-flex flex-column justify-content-center" style="min-height: 120px;">
                                    <div class="fw-bold h5 mb-1">День @i</div>
                                    
                                    @if (dayData != null)
                                    {
                                        <div class="small text-truncate mb-2">@dayData.Title</div>
                                        <div class="d-flex justify-content-center gap-1 mt-auto">
                                            <a asp-action="EditDay" asp-route-id="@dayData.Id" class="btn btn-sm btn-outline-primary py-0 px-2" title="Редактировать">✏️</a>
                                            <form asp-action="DeleteDay" asp-route-id="@dayData.Id" method="post" onsubmit="return confirm('Удалить этот день?')">
                                                <button type="submit" class="btn btn-sm btn-outline-danger py-0 px-2">🗑️</button>
                                            </form>
                                        </div>
                                    }
                                    else
                                    {
                                        <a asp-action="EditDay" asp-route-dayNumber="@i" class="btn btn-sm btn-outline-secondary mt-auto py-1">➕ Добавить</a>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .border-dashed { border: 2px dashed #dee2e6 !important; }
    .card { border-radius: 12px; }
</style>