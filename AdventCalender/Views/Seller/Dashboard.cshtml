@model AdventCalender.Models.ApplicationUser

@{
    ViewData["Title"] = "Панель управления магазином";
    
    var filledDaysCount = Model.AdventDays.Count(d => d.DayNumber <= Model.CalendarDaysCount);
    int progressPercent = (int)((filledDaysCount / (double)Model.CalendarDaysCount) * 100);
}

<div class="container py-4">
    
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm mb-4 rounded-4" role="alert">
            <div class="d-flex align-items-center">
                <span class="fs-4 me-3">✅</span>
                <div>@TempData["Success"]</div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card border-0 shadow-sm rounded-4 mb-5 overflow-hidden">
        <div class="card-body p-4 p-md-5 bg-white">
            <div class="row align-items-center">

                <div class="col-lg-7 mb-4 mb-lg-0">
                    <div class="d-flex align-items-center mb-3">
                        <div class="bg-danger bg-opacity-10 p-3 rounded-4 me-3">
                            <span class="h2 mb-0">🏪</span>
                        </div>
                        <div>
                            <h2 class="fw-bold mb-0">@Model.StoreName</h2>
                            <p class="text-muted mb-0">Имя продавца: <span class="badge bg-light text-dark fw-normal">@Model.Nickname</span></p>
                        </div>
                    </div>
                    <p class="text-muted mb-4 pe-lg-5 fs-5">
                        @(string.IsNullOrEmpty(Model.Description) ? "Описание магазина еще не заполнено. Добавьте его в настройках." : Model.Description)
                    </p>
                    <button class="btn btn-dark rounded-pill px-4 shadow-sm" type="button" data-bs-toggle="collapse" data-bs-target="#editSettings">
                        ⚙️ Настройки магазина
                    </button>
                </div>

                <div class="col-lg-5">
                    <div class="bg-light p-4 rounded-4 border border-white border-2 shadow-sm">
                        <div class="d-flex justify-content-between align-items-end mb-2">
                            <div>
                                <h6 class="text-uppercase fw-bold text-muted small mb-1">Готовность календаря</h6>
                                <span class="h3 fw-bold mb-0 text-danger">@filledDaysCount <span class="text-muted h5 fw-normal">/ @Model.CalendarDaysCount</span></span>
                            </div>
                            <span class="badge bg-danger rounded-pill px-3 py-2 shadow-sm">@progressPercent%</span>
                        </div>
                        <div class="progress rounded-pill bg-white mb-2" style="height: 14px;">
                            <div class="progress-bar progress-bar-striped progress-bar-animated bg-danger" 
                                 role="progressbar" style="width: @progressPercent%"></div>
                        </div>
                        <small class="text-muted fw-light">Заполните все ячейки, чтобы ваш календарь выглядел профессионально.</small>
                    </div>
                </div>
            </div>

            <div class="collapse mt-4" id="editSettings">
                <div class="p-4 bg-light rounded-4 border">
                    <h5 class="fw-bold mb-3">Редактировать профиль</h5>
                    <form asp-action="UpdateStore" method="post" class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label small fw-bold">Название магазина</label>
                            <input type="text" name="storeName" class="form-control rounded-3" value="@Model.StoreName" required>
                        </div>
                        <div class="col-md-5">
                            <label class="form-label small fw-bold">Краткое описание</label>
                            <input type="text" name="description" class="form-control rounded-3" value="@Model.Description">
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small fw-bold">Длительность (дней)</label>
                            <select name="calendarDaysCount" class="form-select rounded-3">
                                @foreach (var count in new[] { 7, 14, 24, 25, 30, 31 })
                                {
                                    <option value="@count" selected="@(Model.CalendarDaysCount == count ? "selected" : null)">@count дней</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="small fw-bold">Дата запуска</label>
                            <input type="date" name="calendarStartDate" class="form-control rounded-3" 
                                   value="@Model.CalendarStartDate.ToString("yyyy-MM-dd")" required>
                        </div>

                        <div class="col-12 text-end mt-4">
                            <button type="button" class="btn btn-link text-muted me-2 text-decoration-none" data-bs-toggle="collapse" data-bs-target="#editSettings">Отмена</button>
                            <button type="submit" class="btn btn-primary px-5 rounded-pill shadow">Сохранить изменения</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="fw-bold mb-0">📅 Ваши ячейки</h4>
        <div class="text-muted small">Выбрана раскладка на <strong>@Model.CalendarDaysCount дней</strong></div>
    </div>

    <div class="row row-cols-2 row-cols-sm-3 row-cols-md-4 row-cols-lg-6 g-3">
        @for (int i = 1; i <= Model.CalendarDaysCount; i++)
        {
            var dayData = Model.AdventDays.FirstOrDefault(d => d.DayNumber == i);
            
            <div class="col">
                <div class="card h-100 border-0 shadow-sm day-card @(dayData != null ? "active-day" : "empty-day")">
                    <div class="card-body p-3 text-center d-flex flex-column h-100">
                        <div class="day-number mb-2">@i</div>
                        
                        @if (dayData != null)
                        {
                            <div class="small fw-bold text-truncate mb-1" title="@dayData.Title">@dayData.Title</div>
                            <div class="text-danger fw-bold small mb-3">@dayData.Price.ToString("N0") $</div>
                            
                            <div class="mt-auto d-flex justify-content-center gap-1">
                                <a asp-action="EditDay" asp-route-id="@dayData.Id" 
                                   class="btn btn-sm btn-white border shadow-sm rounded-circle p-0 d-flex align-items-center justify-content-center" 
                                   style="width: 32px; height: 32px;" title="Изменить">✏️</a>
                                
                                <form asp-action="DeleteDay" asp-route-id="@dayData.Id" method="post" 
                                      onsubmit="return confirm('Вы уверены, что хотите удалить товар из ячейки @i?')">
                                    <button type="submit" class="btn btn-sm btn-white border shadow-sm rounded-circle p-0 d-flex align-items-center justify-content-center text-danger" 
                                            style="width: 32px; height: 32px;" title="Удалить">🗑️</button>
                                </form>
                            </div>
                        }
                        else
                        {

                            <div class="mt-auto">
                                <a asp-action="EditDay" asp-route-dayNumber="@i" 
                                   class="btn btn-sm btn-outline-secondary border-dashed rounded-3 w-100 py-3 shadow-none">
                                    <div class="small fw-bold">+ Добавить</div>
                                </a>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<style>
    body { background-color: #f3f6f9; }
    
    .rounded-4 { border-radius: 1.25rem !important; }
    
    .day-card {
        border-radius: 1.25rem;
        transition: all 0.25s ease;
        border: 2px solid transparent !important;
    }
    
    .day-card.empty-day {
        background-color: rgba(255,255,255,0.4);
    }
    
    .day-card.active-day {
        background: white;
        border-bottom-color: #dc3545 !important;
    }
    
    .day-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 0.8rem 1.5rem rgba(0,0,0,0.08) !important;
    }
    
    .day-number {
        font-size: 1.6rem;
        font-weight: 900;
        color: #dee2e6;
        line-height: 1;
        letter-spacing: -1px;
    }
    
    .active-day .day-number {
        color: #dc3545; 
    }
    
    .border-dashed {
        border: 2px dashed #ced4da !important;
    }
    .border-dashed:hover {
        border-color: #dc3545 !important;
        background-color: #fff !important;
        color: #dc3545 !important;
    }

    .btn-white {
        background-color: white;
        transition: all 0.2s;
    }
    .btn-white:hover {
        background-color: #f8f9fa;
        transform: scale(1.1);
    }

    .progress-bar-animated {
        animation: progress-bar-stripes 1s linear infinite;
    }
</style>