@using System.Globalization

@model AdventCalender.Models.AdventDay

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow">
                <div class="row g-0">
                    <div class="col-md-6">
                        <img src="@(Model.ImageUrl ?? "https://via.placeholder.com/400")" class="img-fluid rounded-start" alt="...">
                    </div>
                    <div class="col-md-6">
                        <div class="card-body">
                            <h5 class="card-title">День @Model.DayNumber: @Model.Title</h5>
                            <p class="card-text">@Model.Description</p>
                            <h4 class="text-primary">@Model.Price.ToString("C", CultureInfo.GetCultureInfo("en-US"))</h4>
                            
                            <hr />
                            
                            @if (Model.IsPaid)
                            {
                                <div class="alert alert-success">
                                    Товар уже оплачен!
                                </div>
                            }
                            else
                            {
                                <form asp-controller="Order" asp-action="CreateOrder" method="post">
                                    <input type="hidden" name="adventDayId" value="@Model.Id" />
                                    <button type="submit" class="btn btn-warning btn-lg w-100">Оплатить</button>
                                </form>
                            }
                            <a asp-action="Index" asp-route-sellerId="@Model.SellerId" class="btn btn-link mt-3">Назад к календарю</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>