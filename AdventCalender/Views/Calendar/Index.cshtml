@model AdventCalender.Models.ApplicationUser

@{
    ViewData["Title"] = Model.StoreName;
    int totalDays = Model.CalendarDaysCount > 0 ? Model.CalendarDaysCount : 24;
    
    int currentDay = DateTime.Now.Day;
    bool isDecember = DateTime.Now.Month == 12;
}

<div class="container py-4">
    <div class="text-center mb-5">
        <h1 class="display-4 fw-bold text-danger">🎄 @Model.StoreName</h1>
        <p class="lead text-muted">@Model.Description</p>
    </div>

    <div class="row g-3">
        @for (int i = 1; i <= totalDays; i++) 
        {
            var dayData = Model.AdventDays.FirstOrDefault(d => d.DayNumber == i);
            bool isLocked = isDecember && i > currentDay; 

            <div class="col-6 col-md-4 col-lg-2">
                @if (isLocked)
                {
                    <div class="card h-100 border-0 shadow-sm bg-light opacity-75">
                        <div class="card-body text-center p-4">
                            <span class="h2 fw-bold text-muted">@i</span>
                            <div class="mt-2 small text-uppercase">🔒
                                <a asp-controller="Calendar" asp-action="DayDetails" asp-route-id="@dayData.Id" 
                                 class="btn btn-sm btn-outline-danger rounded-pill px-3">Открыть</a>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="card h-100 border-0 shadow-sm">
                        <div class="card-body text-center p-4">
                            <span class="h2 fw-bold text-danger">@i</span>
                            @if (dayData != null)
                            {
                                <div class="mt-2">
                                    <a asp-action="DayDetails" asp-route-id="@dayData.Id" 
                                       class="btn btn-sm btn-outline-danger rounded-pill px-3">Открыть</a>
                                </div>
                            }
                            else
                            {
                                <div class="mt-2 small text-muted">Скоро...</div>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

<style>
    body { background-color: #f4f7f6; }

    .locked-card {
        background: #adb5bd; 
        border-radius: 20px;
        cursor: not-allowed;
    }

    .opened-card {
        background: #ffffff;
        border-radius: 20px;
        transition: all 0.3s cubic-bezier(.25,.8,.25,1);
    }

    .opened-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 15px 30px rgba(220, 53, 69, 0.2) !important;
    }
    
    .display-6 {
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }
</style>