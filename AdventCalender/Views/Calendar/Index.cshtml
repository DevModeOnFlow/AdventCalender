@model AdventCalender.Models.ApplicationUser

@{
    ViewData["Title"] = Model.StoreName;

    // Текущие дата и время
    DateTime now = DateTime.Now;
    DateTime today = now.Date;
    TimeSpan currentTime = now.TimeOfDay;

    // Дата старта этого конкретного продавца
    DateTime startDate = Model.CalendarStartDate.Date;
    int totalDays = Model.CalendarDaysCount;
}

<div class="container py-5">
    <div class="text-center mb-5">
        <h1 class="display-4 fw-bold text-danger mb-2">🎄 @Model.StoreName</h1>
        <p class="text-muted">Дата старта: <strong>@startDate.ToString("dd MMMM yyyy")</strong></p>
    </div>

    <div class="row row-cols-2 row-cols-md-4 row-cols-lg-6 g-4">
        @for (int i = 1; i <= totalDays; i++)
        {
            var dayData = Model.AdventDays.FirstOrDefault(d => d.DayNumber == i);
            
            // Вычисляем дату, когда должен открыться этот "День i"
            // День 1 открывается в дату старта, День 2 - через 1 день и т.д.
            DateTime targetDate = startDate.AddDays(i - 1);

            // Статусы
            bool isFuture = today < targetDate;
            bool isPast = today > targetDate;
            bool isToday = today == targetDate;

            bool isEarly = dayData != null && currentTime < dayData.StartTime;
            bool isLate = dayData != null && currentTime > dayData.EndTime;
            bool isActive = isToday && !isEarly && !isLate;

            <div class="col">
                @if (isFuture)
                {
                    @* БУДУЩЕЕ: Закрыто, пишем дату открытия *@
                    <div class="card h-100 border-0 shadow-sm locked-card">
                        <div class="card-body text-center p-4">
                            <span class="h1 fw-bold opacity-25">@i</span>
                            <div class="small fw-bold opacity-50 mt-2">@targetDate.ToString("dd.MM")</div>
                            <div class="mt-1">🔒</div>
                        </div>
                    </div>
                }
                else if (isPast || (isToday && isLate))
                {
                    @* ПРОШЛОЕ: Время вышло *@
                    <div class="card h-100 border-0 shadow-sm bg-light opacity-75">
                        <div class="card-body text-center p-4">
                            <span class="h1 fw-bold text-muted">@i</span>
                            <div class="badge bg-secondary rounded-pill">⌛ Истекло</div>
                        </div>
                    </div>
                }
                else if (isToday && isEarly && dayData != null)
                {
                    @* СЕГОДНЯ, НО РАНО: Таймер *@
                    <div class="card h-100 border-0 shadow-sm border-primary" style="border-width: 2px !important;">
                        <div class="card-body text-center p-4 bg-primary bg-opacity-10">
                            <span class="h2 fw-bold text-primary">День @i</span>
                            <div class="small fw-bold text-uppercase mt-2">Ждите:</div>
                            <div class="fw-bold timer-display" data-start="@dayData.StartTime.ToString()">--:--</div>
                        </div>
                    </div>
                }
                else if (isActive && dayData != null)
                {
                    @* АКТИВНО СЕЙЧАС *@
                    <div class="card h-100 border-0 shadowOpened shadow opened-card border-success" style="border-width: 2px !important;">
                        <div class="card-body text-center p-4">
                            <span class="display-6 fw-bold text-success">@i</span>
                            <div class="small fw-bold text-truncate mb-2">@dayData.Title</div>
                            <a asp-action="DayDetails" asp-route-id="@dayData.Id" class="btn btn-success btn-sm rounded-pill w-100 shadow-sm">ОТКРЫТЬ</a>
                            <div class="mt-2 text-danger fw-bold" style="font-size: 0.65rem;">До @dayData.EndTime.ToString(@"hh\:mm")</div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="card h-100 border-0 shadow-sm bg-light"><div class="card-body text-center">@i<br/>Пусто</div></div>
                }
            </div>
        }
    </div>
</div>

<script>
    function updateTimers() {
        const now = new Date();
        document.querySelectorAll('.timer-display').forEach(el => {
            const startTimeStr = el.getAttribute('data-start');
            const parts = startTimeStr.split(':');
            
            const target = new Date();
            target.setHours(parts[0], parts[1], parts[2] || 0);

            const diff = target - now;

            if (diff > 0) {
                const h = Math.floor(diff / 3600000);
                const m = Math.floor((diff % 3600000) / 60000);
                const s = Math.floor((diff % 60000) / 1000);
                el.innerText = `${h}ч ${m}м ${s}с`;
            } else {
                location.reload(); 
            }
        });
    }

    setInterval(updateTimers, 1000);
    updateTimers();
</script>

<style>
    body { background-color: #fdfdfd; }

    .locked-card {
        background: linear-gradient(135deg, #e9ecef 0%, #dee2e6 100%);
        border-radius: 20px;
        color: #adb5bd;
        cursor: not-allowed;
    }
    .lock-icon {
        font-size: 1.5rem;
        filter: grayscale(1);
        opacity: 0.5;
    }

    .opened-card {
        background: #ffffff;
        border-radius: 20px;
        transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }
    .opened-card:hover {
        transform: translateY(-10px);
        box-shadow: 0 15px 30px rgba(0,0,0,0.1) !important;
    }

    .today-card {
        border: 2px solid #0d6efd !important;
        background-color: #f0f7ff;
    }

    .hover-grow {
        transition: transform 0.2s;
    }
    .hover-grow:hover {
        transform: scale(1.1);
    }

    .display-6 {
        font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    }
    
    .rounded-bottom-4 {
        border-bottom-left-radius: 20px;
        border-bottom-right-radius: 20px;
    }

    .timer-display {
        font-family: monospace;
        font-size: 1.1rem;
    }
</style>