@model AdventCalender.Models.RegisterViewModel

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card shadow-lg border-0">
                <div class="card-body p-5">
                    <h2 class="text-center mb-4">Регистрация</h2>
                    <form asp-action="Register" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger small"></div>

                        <div class="mb-3">
                            <label class="form-label">Email</label>
                            <input asp-for="Email" class="form-control" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Пароль</label>
                            <input asp-for="Password" class="form-control" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Повторите пароль</label>
                            <input asp-for="ConfirmPassword" class="form-control" />
                        </div>

                        <div class="mb-4">
                            <label class="form-label d-block">Я хочу быть:</label>
                            <div class="btn-group w-100" role="group">
                                <input type="radio" class="btn-check" name="Role" id="roleBuyer" value="Buyer" checked onchange="toggleStoreField(false)">
                                <label class="btn btn-outline-primary" for="roleBuyer">Покупателем</label>

                                <input type="radio" class="btn-check" name="Role" id="roleSeller" value="Seller" onchange="toggleStoreField(true)">
                                <label class="btn btn-outline-primary" for="roleSeller">Продавцом</label>
                            </div>
                        </div>

                        <div id="storeNameField" class="mb-3 d-none">
                            <label class="form-label">Название вашего магазина</label>
                            <input asp-for="StoreName" class="form-control" />
                        </div>

                        <button type="submit" class="btn btn-danger w-100 py-2">Создать аккаунт</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function toggleStoreField(show) {
        const field = document.getElementById('storeNameField');
        if (show) field.classList.remove('d-none');
        else field.classList.add('d-none');
    }
</script>