@model AdventCalender.Models.RegisterViewModel

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-body p-5">
                    <h2 class="text-center mb-4 fw-bold">🎁 Регистрация</h2>
                    <form asp-action="Register" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                        <div class="mb-3">
                            <label class="form-label text-muted small fw-bold">Никнейм</label>
                            <input asp-for="Nickname" class="form-control form-control-lg bg-light border-0 shadow-sm" />
                            <span asp-validation-for="Nickname" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label text-muted small fw-bold">Email</label>
                            <input asp-for="Email" class="form-control form-control-lg bg-light border-0 shadow-sm"/>
                        </div>

                        <div class="mb-3">
                            <label class="form-label text-muted small fw-bold">Пароль</label>
                            <input asp-for="Password" type="password" id="pass1" class="form-control form-control-lg bg-light border-0 shadow-sm" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label text-muted small fw-bold">Повторите пароль</label>
                            <input asp-for="ConfirmPassword" type="password" id="pass2" class="form-control form-control-lg bg-light border-0 shadow-sm" />
                        </div>

                        <div class="mb-4 form-check">
                            <input type="checkbox" class="form-check-input" id="showPassCheck" onclick="togglePasswordVisibility()">
                            <label class="form-check-label small text-muted" for="showPassCheck">Показать пароли</label>
                        </div>

                        <div class="mb-4">
                            <label class="form-label d-block text-muted small fw-bold">Я хочу быть:</label>
                            <div class="btn-group w-100" role="group">
                                <input type="radio" class="btn-check" name="Role" id="roleBuyer" value="Buyer" checked onchange="toggleStoreField(false)">
                                <label class="btn btn-outline-primary rounded-start-pill py-2" for="roleBuyer">Покупателем</label>

                                <input type="radio" class="btn-check" name="Role" id="roleSeller" value="Seller" onchange="toggleStoreField(true)">
                                <label class="btn btn-outline-primary rounded-end-pill py-2" for="roleSeller">Продавцом</label>
                            </div>
                        </div>

                        <div id="storeNameField" class="mb-4 d-none">
                            <label class="form-label text-muted small fw-bold">Название магазина</label>
                            <input asp-for="StoreName" class="form-control form-control-lg bg-light border-0 shadow-sm" />
                        </div>

                        <button type="submit" class="btn btn-success btn-lg w-100 py-3 rounded-pill shadow fw-bold hover-glow mt-2 border-0" style="background: linear-gradient(45deg, #28a745, #218838);">
                            Создать аккаунт ✨
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function togglePasswordVisibility() {
        const p1 = document.getElementById("pass1");
        const p2 = document.getElementById("pass2");
        const isChecked = document.getElementById("showPassCheck").checked;
        
        p1.type = isChecked ? "text" : "password";
        p2.type = isChecked ? "text" : "password";
    }

    function toggleStoreField(show) {
        const field = document.getElementById('storeNameField');
        field.classList.toggle('d-none', !show);
    }
</script>

    @section Scripts {
        @await Html.PartialAsync("_ValidationScriptsPartial")
    }