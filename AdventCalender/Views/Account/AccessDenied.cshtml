@{
    ViewData["Title"] = "Доступ ограничен";
}

<div class="container py-5 mt-5 text-center">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card border-0 shadow-lg p-5">
                <p class="lead text-muted mb-4">
                    Что-то пошло не так. 
                </p>
                
                <div class="d-grid gap-2 d-sm-flex justify-content-sm-center">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-primary btn-lg px-4 gap-3 rounded-pill shadow-sm">
                        На главную
                    </a>
                    
                    @if (User.Identity.IsAuthenticated)
                    {
                        <form asp-action="Logout" method="post" class="d-inline">
                            <button type="submit" class="btn btn-outline-secondary btn-lg px-4 rounded-pill">
                                Сменить аккаунт
                            </button>
                        </form>
                    }
                </div>

                <div class="mt-5 small text-muted">
                    Если вы считаете, что это ошибка, пожалуйста, обратитесь в поддержку.
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    body {
        background: #f8f9fa;
    }
    .card {
        border-radius: 30px;
    }
</style>